  "communityPage.badge": "Community",
  "communityPage.channel0Body": "Platform changes ship with a feedback window. The split and moderation heuristics are published for public audit — check our work.",
  "communityPage.channel0Title": "You get a vote",
  "communityPage.channel1Body": "Every DJ and promoter gets the same hosting tools, free. No tier unlocks anything — the scene decides what gets heard.",
  "communityPage.channel1Title": "Radio shows",
  "communityPage.channel2Body": "No bots, no paid manipulation, no hidden incentives. Hype is the demand signal venues book from — keep it real.",
  "communityPage.channel2Title": "Hype honestly",
  "communityPage.channel3Body": "Report unsafe content, fraud, or impersonation. Every report is tracked to a resolution in the public trust & safety report.",
  "communityPage.channel3Title": "Look out for each other",
  "communityPage.ctaLink": "Read the charter →",
  "communityPage.heroTitle": "The scene runs this place.",
  "communityPage.lede": "Users of iHYPE are stakeholders, not just customers. Meaningful changes — the split, moderation rules, new fees of any kind — are put to the people who use it.",
  "communityRulesPage.badge": "Community",
  "communityRulesPage.intro": "iHYPE should be useful, human, and fair. That means no harassment, fraud, manipulation, or unsafe content.",
  "communityRulesPage.reportProblemsBody": "Users should report unsafe content, rights concerns, fraud, impersonation, or ticket issues so admins can review them in the beta console.",
  "communityRulesPage.reportProblemsTitle": "Report problems",
  "communityRulesPage.respectPeopleBody": "No harassment, threats, hate, doxxing, impersonation, or targeted abuse of fans, artists, venues, promoters, staff, or volunteers.",
  "communityRulesPage.respectPeopleTitle": "Respect people",
  "communityRulesPage.respectSignalBody": "Do not use bots, fake accounts, paid manipulation, or hidden incentives to distort hype, rankings, playlists, or recommendations.",
