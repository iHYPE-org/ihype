DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Use a direct/non-pooled Postgres URL for Prisma migrations. Deployment maps
# this value to DATABASE_URL only for `prisma migrate deploy`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
# Rotation window (docs/runbooks/secret-rotation.md): the NEWEST key goes in
# AUTH_SECRET_1 and signs; AUTH_SECRET then only verifies. _2/_3 hold retired
# keys so unsubscribe links sent before a rotation keep working. Leave unset
# until you rotate.
# AUTH_SECRET_1=""
# AUTH_SECRET_2=""
# AUTH_SECRET_3=""
AUTH_URL="https://ihype.org"
NEXT_PUBLIC_APP_URL="https://ihype.org"
# Local Workerd preview only. The bypass also requires a loopback hostname,
# so this flag cannot enable passwordless access on ihype.org.
LOCAL_AUTH_SKIP="false"

# Email carries the magic link (the only way in besides a passkey — there are
# no passwords and no MFA codes in this product) and the ticket emails.
# Resend is the only mailer; there is no SMTP path.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="iHYPE <no-reply@ihype.org>"
# Test-only mail sink: when set to a LOOPBACK URL the mailer posts every email
# there instead of Resend, so the acceptance walk can read them back. Any
# non-loopback value is ignored, so this is inert on a real Worker.
# EMAIL_SINK_URL="http://127.0.0.1:8791/emails"

# Operations. CRON_SECRET authorises /api/cron/* (a launch blocker in
# /api/health when unset). Operational alerts are NOT configurable — they
# always go to admin@ihype.org (src/lib/env.ts's ADMIN_ALERT_ADDRESS); the
# ADMIN_ALERT_EMAIL override was removed 2026-09-15 by owner instruction, so
# if it is still set as a Worker secret it is inert and can be deleted.
# ADMIN_ALLOWED_EMAILS replaces the default admin allowlist
# for the session-role clamp only — `isAdminSession()` deliberately ignores it,
# so a second administrator is a code change (src/lib/admin-allowlist.ts).
CRON_SECRET=""
# ADMIN_ALLOWED_EMAILS="admin@ihype.org,staff@ihype.org"
# ISO timestamp of the last hand-run backup restore drill
# (docs/runbooks/backup-restore-drill.md); the nightly drill writes its own key.
RESTORE_DRILL_VERIFIED_AT=""
# Logger floor: debug outside production, info in it. Set to override.
# LOG_LEVEL="info"
# Rate limiter deadlines in ms; read the arithmetic above DEFAULT_DO_TIMEOUT_MS
# in src/lib/rate-limit.ts before changing either — they are a combined budget.
# RATE_LIMIT_DO_TIMEOUT_MS="1800"
# RATE_LIMIT_KV_TIMEOUT_MS="1000"

# Optional platform integrations. AI runs on Workers AI (the `AI` binding in
# wrangler.toml) — there is no OpenAI key. Media lives in R2 through the
# Worker's binding — there is no storage credential.
# ACRCloud — acoustic fingerprinting for the track-upload copyright scan
# (Layer 1). Host is the region-specific identify endpoint from your
# ACRCloud project's Access tab, e.g. identify-eu-west-1.acrcloud.com.
# All three required to activate the scan; unset = layer shows "not configured".
ACRCLOUD_HOST=""
ACRCLOUD_ACCESS_KEY=""
ACRCLOUD_ACCESS_SECRET=""
# CARTO basemap key. The public demo key is compiled in as the fallback;
# set this to use your own.
# NEXT_PUBLIC_CARTO_BASEMAP_KEY=""

# Paid ticketing is live in production (501(c)(3) certified, real Stripe
# Connect charges/payouts). Defaults to false here so local/dev setups
# without Stripe credentials don't attempt real charges.
FEATURE_ENABLE_TICKET_PAYMENTS="false"
# Runtime fallbacks for the audited admin safety switches. KV overrides from
# the admin portal take effect immediately without a deploy.
FEATURE_ENABLE_PAYMENTS="false"
FEATURE_ENABLE_TICKETING="true"
FEATURE_ENABLE_RADIO="true"
FEATURE_ENABLE_MAPS="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Signing secret of the SECOND dashboard endpoint — the one set to "listen to
# events on connected accounts" — which venue-direct ticket sales arrive on.
# Optional; without it those events answer 400 and never issue tickets.
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Lets a NON-production build accept an sk_test_ key for the money-path
# rehearsal (docs/runbooks/money-path-rehearsal.md). Never set in production.
# STRIPE_ALLOW_TEST_MODE_REHEARSAL="true"

# REQUIRED for closed beta. Generate high-entropy codes rather than memorable
# public words, for example: openssl rand -hex 16
BETA_INVITE_CODES="replace-with-a-random-32-character-code"
TURNSTILE_SECRET_KEY=""

# Web Push (VAPID) — required for push notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ihype.org"

# Native (iOS/Android) push notifications.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Universal Links (iOS) / App Links (Android).
APPLE_TEAM_ID=""
ANDROID_CERT_SHA256_FINGERPRINTS=""

# Production safety switches.
ALLOW_ADMIN_SETUP="false"
ADMIN_SETUP_SECRET=""
ADMIN_DEVICE_SECRET=""
FEATURE_REQUIRE_INVITE_CODE="true"
FEATURE_ALLOW_DATABASE_MEDIA_STORAGE="false"
# `prisma db seed` refuses a production database unless this is set for a
# controlled maintenance run.
ALLOW_PRODUCTION_SEEDING="false"
# Defaults to true outside production. This is the ONE switch for demo
# visibility: with it off in production, demo accounts' profiles and shows are
# hidden everywhere. (The `flags:demo_logins` / `flags:hide_demo_content` KV
# toggles that used to sit beside it were read by nothing that enforced them
# and are gone, 2026-09-06.)
FEATURE_ENABLE_DEMO_LOGINS="false"

# Sentry error monitoring (optional).
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Web Analytics (optional and cookieless).
NEXT_PUBLIC_CF_BEACON_TOKEN=
