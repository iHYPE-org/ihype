{
  "name": "ihype",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node scripts/build-i18n-assets.mjs && next dev --webpack",
    "prebuild": "npm run guard:design && node scripts/build-i18n-assets.mjs && node scripts/bump-sw-version.mjs",
    "build": "next build --webpack",
    "guard:design": "node scripts/guard-claude-design.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-source.mjs",
    "guard:migrations": "node scripts/check-gated-migrations.mjs",
    "vendor:ds": "node scripts/vendor-ds-components.mjs",
    "guard:ds": "node scripts/vendor-ds-components.mjs --check",
    "audit:shell": "node scripts/audit-shell-classes.mjs",
    "audit:design": "node scripts/audit-design-templates.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:unstyled": "node scripts/audit-unstyled-classes.mjs",
    "audit:contrast": "node scripts/audit-theme-contrast.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:mounts": "node scripts/audit-mounts.mjs --max=0",
    "audit:spacing": "node scripts/audit-spacing.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "seed:admin-preview": "node --import dotenv/config scripts/seed-admin-preview-profiles.mjs",
    "seed:preview": "node --import dotenv/config scripts/seed-preview-content.mjs",
    "seed:preview:remove": "node --import dotenv/config scripts/seed-preview-content.mjs --remove",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "measure:dock": "node scripts/measure-dock.mjs",
    "measure:datepick": "node scripts/measure-datepicker.mjs",
    "app-links:write": "node scripts/generate-app-links.mjs",
    "check:app-links": "node scripts/generate-app-links.mjs --check",
    "check:basemap": "node scripts/check-basemap.mjs",
    "check:alpha": "node --import dotenv/config scripts/beta-launch-check.mjs",
    "verify:acrcloud": "tsx --env-file-if-exists=.env scripts/verify-acrcloud.ts",
    "verify:restore": "node --import dotenv/config scripts/verify-restored-backup.mjs",
    "backup:database": "node --import dotenv/config scripts/backup-database.mjs",
    "backup:restore": "node --import dotenv/config scripts/restore-backup.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "node scripts/e2e-workerd.mjs e2e/responsive.spec.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:launch": "tsx prisma/launch-seed.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "smoke:production": "node scripts/smoke-production.mjs",
    "stripe:rehearsal": "node scripts/stripe-payout-rehearsal.mjs",
    "stripe:disputes": "node scripts/stripe-dispute-walk.mjs",
    "admin:reset-test-logins": "node scripts/reset-test-logins.mjs",
    "analyze": "ANALYZE=true npm run build",
    "cf:build": "node scripts/build-i18n-assets.mjs && node scripts/bump-sw-version.mjs && opennextjs-cloudflare build && node scripts/patch-worker-bundle.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy worker.js --autoconfig=false",
    "cap:sync": "cap sync && node scripts/normalize-capacitor-spm.mjs",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "clear:users": "node scripts/clear-all-users.mjs",
    "audit:retro": "node scripts/audit-retro-coverage.mjs --max=0",
    "design:handoff": "node scripts/build-console-handoff.mjs",
    "measure:layout": "tsx scripts/measure-layout.mts",
    "rehearse:money": "tsx scripts/rehearse-money-path.mts",
    "alpha:walk": "tsx scripts/alpha-acceptance-walk.mts",
    "feature:health": "tsx scripts/feature-health.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/cloudflare": "10.70.0",
    "@sentry/nextjs": "^10.70.0",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^3.0.3",
    "maplibre-gl": "^6.5.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "lighthouse": "^13.4.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "postcss": {
      ".": "^8.5.18",
      "nanoid": "^3.3.17"
    },
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "next-auth": "5.0.0-beta.32",
    "@auth/prisma-adapter": "2.11.3",
    "sharp": "^0.35.3"
  }
}
