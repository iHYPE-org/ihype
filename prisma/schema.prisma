  id                    String         @id @default(cuid())
  slotId                String
  advertiserId          String
  title                 String
  audioUrl              String?
  // Server-computed at upload time (src/lib/audio-duration.ts) — lets the
  // radio ad-interjection module (RadioShowCreator's ad breaks) size a real
  // spot into a timeline the same way it already does for placeholder clips.
  audioDurationSecs     Int?
  clickUrl              String?
  status                String         @default("PENDING")
  // Coverage tier the campaign was purchased at — LOCAL | REGIONAL | NATIONAL | GLOBAL.
  // Drives per-spot pricing and reach; separate from slotId (the placement).
  scope                 String         @default("REGIONAL")
  budgetCents           Int            @default(0)
  spentCents            Int            @default(0)
  impressions           Int            @default(0)
  // Ad.clicks removed: an audio spot has no click-through surface, so nothing
  // ever incremented it. The column drop is parked in
  // prisma/migrations-pending/20260728201000_drop_ad_clicks — this field goes
  // first so the deployed code has stopped selecting it before the column
  // disappears.
  // Purchased run length — set at creation, before payment is authorized.
  // startsAt/endsAt aren't resolved to real dates until authorization
  // succeeds (see stripePaymentIntentId), so a campaign stuck awaiting
  // manual review or payment never loses run length to the wait.
  runDays               Int?
  startsAt              DateTime?
  endsAt                DateTime?
  // Set while status is PAUSED — on resume, endsAt shifts forward by
  // (now - pausedAt) so a pause never eats into the run length the
  // advertiser actually paid for.
  pausedAt              DateTime?
  // Pre-auth-then-capture billing (DESIGN_SYNC row 234): a manual-capture
  // Stripe PaymentIntent (via Checkout Session) authorizes the full quoted
  // budget once vetting clears; only the actual spentCents at campaign end
  // (or early cancellation) is ever captured — never the full hold.
  stripePaymentIntentId String?        @unique
  authorizedAt          DateTime?
  settledAt             DateTime?
  // What settlement actually did with the money, so the advertiser can read
  // it back (2026-09-02): the part of the charge that stayed charged, the
  // part refunded, and the Stripe refund it is traceable by. Null on a
  // campaign settled before these existed — rendered as unknown, never as 0.
  settledChargedCents   Int?
  refundedCents         Int?
  stripeRefundId        String?
  createdAt             DateTime       @default(now())
  slot                  AdSlot         @relation(fields: [slotId], references: [id])
  advertiser            User           @relation(fields: [advertiserId], references: [id])
  impressionLog         AdImpression[]

  @@index([slotId, status])
  @@index([advertiserId])
}

model AdImpression {
  id        String   @id @default(cuid())
  adId      String
  userId    String?
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id])

  @@index([adId, createdAt])
}

model NewsletterSubscription {
  id                    String    @id @default(cuid())
  email                 String
  profileId             String
  // Double opt-in: row is written on subscribe but only actioned once
  // confirmedAt is set via the emailed confirm link. confirmToken is
  // single-use and time-boxed; both are cleared once confirmed.
  confirmedAt           DateTime?
  confirmToken          String?   @unique
  confirmTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  profile               Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([email, profileId])
  @@index([profileId])
}
