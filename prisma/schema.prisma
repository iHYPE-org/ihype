generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// DJ removed 2026-08-06 (step 4 of docs/dj-role-removal-scope.md). The three
// DJ-typed rows were reassigned to ARTIST in migration
// 20260806130000_reassign_dj_profiles, verified 0 remaining in production
// before this. The DB still carries the value until the parked drop migration
// in prisma/migrations-pending/ is deliberately moved across -- that is the
// repo's gating workflow for irreversible DDL, and it is why the code half
// ships first (same pattern as drop_ad_clicks).
enum Role {
  FAN
  ARTIST
  VENUE
  ADMIN
  ADVERTISER
}

enum ShowStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum ProfileType {
  ARTIST
  VENUE
  LISTENER
}

enum ConnectionRequestType {
  LISTENER
  PROMOTER
}

enum ConnectionRequestStatus {
  PENDING
  BOOKED
  DISMISSED
}

enum OwnershipVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TicketStatus {
  VALID
  SCANNED
  VOID
}

enum TicketOrderStatus {
  RESERVED
  CAPTURED
  VOID
}

enum AccountsPayableCategory {
  TAX_LOCAL
  TAX_STATE
  TAX_COUNTRY
  TAX_INTERNATIONAL
  VENUE_PAYOUT
  ARTIST_PAYOUT
  PROMOTER_AFFILIATE
}

enum LineupSlotStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AccountsPayableStatus {
  PENDING
  RELEASED
  VOID
}

model User {
