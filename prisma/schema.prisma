/// One dated entry on an artist's calendar. `kind` is what the date MEANS,
/// and the two meanings share this table on purpose: both are
/// "profile + date + note", both are owner-managed, and both render in the
/// same calendar in the editor's About section. A separate TourDate model
/// would have duplicated the shape, the ownership checks and the CRUD route
/// to change one string.
model AvailabilityDate {
  id        String           @id @default(cuid())
  profileId String
  date      DateTime
  note      String?
  /// AVAILABLE = open for booking (venues see these on the public page).
  /// TOUR      = a date the artist is playing.
  /// Defaults to AVAILABLE so every pre-existing row keeps the only meaning
  /// it could have had before this column existed.
  kind      AvailabilityKind @default(AVAILABLE)
  createdAt DateTime         @default(now())
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, kind, date])
}

enum AvailabilityKind {
  AVAILABLE
  TOUR
}

