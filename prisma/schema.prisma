model FanFavoriteMedia {
  id                String   @id @default(cuid())
  userId            String
  mediaId           String
  title             String
  artistName        String
  url               String
  artistProfileSlug String?
  notes             String?
  artworkUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
}

/// What a Like can point at. TRACK likes deliberately live in
/// FanFavoriteMedia (they carry playable metadata the player needs); this
/// enum covers the targets that only need identity.
enum LikeTargetType {
  ALBUM
  ARTIST
  VENUE
  ADVERTISEMENT
}

/// One like per user per thing, held until unliked (owner, 2026-08-24:
/// "Only like a track/album/artist/venue/advertisement once, stored to
/// user's account. Likes are saved to account until unliked."). The unique
/// constraint IS the "only once" rule — a second like is an upsert no-op,
/// never a second row.
model Like {
  id         String         @id @default(cuid())
  userId     String
  targetType LikeTargetType
  /// The id in the target's own table: Profile.id for ARTIST/VENUE,
  /// ArtistMediaAsset.id for ALBUM, Ad.id for ADVERTISEMENT. Checked for
  /// existence at the API, not by a foreign key — the targets live in three
  /// tables, and a polymorphic FK does not exist in Postgres.
  targetId   String
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model ArtistMediaAsset {
  id               String           @id @default(cuid())
  hexId            String           @unique
  title            String
  notes            String?
  originalFileName String
  mimeType         String
  fileSizeBytes    Int
  fileDataBase64   String?
  storageProvider  String           @default("database")
  storageKey       String?
  storageUrl       String?
  freeUseEnabled   Boolean          @default(false)
  durationSecs     Int?
  artworkUrl       String?
  sortOrder        Int              @default(0)
  profileId        String
  publishAt        DateTime?
  isPublished      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  radioTracks      RadioShowTrack[]
  albumId          String?
  album            Album?           @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([freeUseEnabled, createdAt])
  @@index([publishAt, isPublished])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "ArtistMediaAsset_title_trgm_idx")
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "ArtistMediaAsset_notes_trgm_idx")
}

/// A release a set of tracks belongs to. Deliberately thin: a title, its cover
/// and an order. Everything playable still lives on ArtistMediaAsset, so a
/// track with no album is the normal case rather than an orphan — singles are
/// how most of this catalogue arrives.
///
/// onDelete: SetNull on the track side, never Cascade: deleting a release must
/// not delete the recordings in it.
model Album {
  id         String             @id @default(cuid())
  profileId  String
  title      String
  artworkUrl String?
  releasedOn DateTime?
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tracks     ArtistMediaAsset[]

  @@index([profileId, sortOrder])
}

