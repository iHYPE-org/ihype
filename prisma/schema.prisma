model EmailDeliveryLog {
  id        String   @id @default(cuid())
  type      String
  recipient String
  status    String
  provider  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
