  name                    String?
  email                   String?                  @unique
  phone                   String?                  @unique
  username                String                   @unique
  passwordHash            String?
  isThirteenOrOlder       Boolean                  @default(true)
  // 18+ attestation — required to buy tickets or share referral links.
  // One-way: settable to true via self-attestation, never back to false.
  isEighteenOrOlder       Boolean                  @default(false)
  emailVerified           DateTime?
  mfaSecret               String?
  mfaEnabledAt            DateTime?
  mfaBackupCodes          String?
  image                   String?
  storedPaymentTokenRef   String?
  storedPaymentTokenBrand String?
  storedPaymentTokenLast4 String?
  stripeCustomerId        String?                  @unique
  role                    Role                     @default(FAN)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  sessions                Session[]
  profiles                Profile[]
  shows                   Show[]                   @relation("CreatedShows")
  ticketOrders            TicketOrder[]            @relation("BuyerTicketOrders")
  hypeEvents              HypeEvent[]
  hypeLedgerEntries       HypeLedgerEntry[]
  featureVotes            FeatureVote[]
  mediaListens            MediaListen[]
  showListens             ShowListen[]
  profileHypeEvents       ProfileHypeEvent[]
  passwordResetCodes      PasswordResetCode[]
  venueConnectionRequests VenueConnectionRequest[]
  scannedTickets          Ticket[]                 @relation("TicketScans")
  reassignedTickets       Ticket[]                 @relation("TicketReassignments")
  ticketTransfersMinted   TicketTransferCode[]     @relation("TicketTransferCodesCreated")
  ticketTransfersClaimed  TicketTransferCode[]     @relation("TicketTransferCodesClaimed")
  fanPlaylists            FanPlaylist[]
  favoriteMedia           FanFavoriteMedia[]
  likes                   Like[]
  auditLogs               AuditLog[]
  contentReports          ContentReport[]
  seeds                   Seed[]
  pageLayout              String[]                 @default([])
  passkeys                Passkey[]
  passkeyBootstrapTokens  PasskeyBootstrapToken[]
  showComments            ShowComment[]
  showRsvps               ShowRsvp[]
  premiumInterests        PremiumInterest[]
  notificationPreference  NotificationPreference?
  follows                 Follow[]                 @relation("FollowerUser")
  notifications           Notification[]
  magicLinkTokens         MagicLinkToken[]
  pushSubscriptions       PushSubscription[]
  nativeDeviceTokens      NativeDeviceToken[]
  emailBounced            Boolean                  @default(false)
  badges                  Badge[]
  showAttendees           ShowAttendee[]
  setlistVotes            SetlistVote[]
  sentBookingRequests     BookingRequest[]         @relation("BookingRequestFromUser")
  advertisedAds           Ad[]
  userSecurityVersion     Int                      @default(0)
  lastLoginCountry        String?
  lastLoginAt             DateTime?
  tosAcceptedAt           DateTime?
  welcomeDay3SentAt       DateTime?
  welcomeDay7SentAt       DateTime?
  weeklyDigestSentAt      DateTime?
  adminDeviceTokenHash    String?
  adminDeviceSetAt        DateTime?
  adminDevices            AdminDevice[]
  earningsSummarySentAt   DateTime?
  advertiserAccount       AdvertiserAccount?
  hypeBalance             Int                      @default(0)
}

/// A device allowed to open the admin console.
///
/// Replaces `User.adminDeviceTokenHash`, which was a SINGLE column and
/// therefore a single device: registering a phone silently revoked the laptop,
/// because the write was an overwrite. That is not a policy anyone chose — the
/// column just never had room for a second row — and it is why the console
/// looked broken on a phone while working on a laptop.
///
/// The legacy column is deliberately NOT dropped here. It is still read as a
/// fallback (see `isRegisteredAdminDevice`), so the device an operator is
/// holding right now keeps working across the deploy; the migration also
/// backfills it into this table. Dropping it is separate, gated work for after
/// this has been live long enough to be sure.
model AdminDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the device token. The token itself only ever lives in the
  /// httpOnly cookie on the device — the same shape the column used.
  tokenHash  String   @unique
  /// Operator-facing name, so a list of devices can be revoked meaningfully.
  label      String?
  createdAt  DateTime @default(now())
  /// Last time this device opened the console, for spotting one to revoke.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// A private, non-public account for a non-"app-user" advertiser (e.g. a gear
// shop, merch printer, or live-production company — the "3rd-Party Accounts"
// path already described in Advertise.dc.html's copy but never actually
// buildable before this). Deliberately separate from Profile: advertisers
// have no public-facing page, so none of Profile's public-profile fields
// (bio, avatar, verification, etc.) apply. Ad.advertiserId still points at
// User directly and is untouched by this model's existence.
enum AdvertiserCategory {
  LABEL
  VENUE_PROMOTER
  GEAR
  TICKETING
  MERCH
  TOUR
}

model AdvertiserAccount {
  id          String              @id @default(cuid())
  userId      String              @unique
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  contactName String?
  website     String?
  category    AdvertiserCategory?
  pitch       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Profile {
  id                            String                      @id @default(cuid())
  slug                          String                      @unique
  hexId                         String                      @unique
  type                          ProfileType
  name                          String
  headline                      String?
  bio                           String?
  aboutContent                  String?
  journalContent                String?
  mediaContent                  String?
  tourContent                   String?
  merchContent                  String?
  requestContent                String?
  recommendContent              String?
  // Artist press kit (JSON: tagline, quotes, achievements, contactEmail)
  // rendered on /artists/[slug]/epk.
  pressKitContent               String?
  topFiveContent                String?
  // Set once, when a creator reaches the end of their onboarding wizard
  // (including via Skip — skipping a step is still finishing). NULL means the
  // "Finish setup" prompt should still show. See
  // src/app/api/profile/onboarding-complete/route.ts.
  onboardedAt                   DateTime?
  pageDraft                     String?
  pageDraftUpdatedAt            DateTime?
  pagePublished                 String?
  pagePublishedAt               DateTime?
  addressLine1                  String?
  contactInfo                   String?
  hoursText                     String?
  hometown                      String?
  // Band roster, one member per line. Free text rather than a relation:
  // a member is a NAME on a page, not an account, and modelling it as
  // rows would imply an identity the product does not have.
  members                       String?
  city                          String?
  stateRegion                   String?
  country                       String?
  postalCode                    String?
  latitude                      Float?
  longitude                     Float?
  heroImage                     String?
  avatarImage                   String?
  logoImage                     String?
  galleryImage                  String?
  companionSpriteSheet          String?
  themePreset                   String                      @default("midnight-neon")
  themeFontPreset               String?
  themeAccentTone               String?
  themeBackdropTone             String?
  fanShareEnabled               Boolean                     @default(false)
  // Up to 4 stat keys (see src/lib/profile-stats.ts STAT_CATALOG) the owner
  // chose to display on their public profile's stat tiles.
  pinnedStats                   String[]                    @default([])
  genres                        String[]
  genre                         String?
  links                         String?
  merchUrl                      String?
  songUploadCount               Int                         @default(0)
  parkingDetails                String?
  stayRecommendations           String?
  upcomingContent               String?
  previousShowHighlights        String?
  stripeConnectAccountId        String?                     @unique
  stripeConnectOnboarded        Boolean                     @default(false)
  verified                      Boolean                     @default(false)
  isVerified                    Boolean                     @default(false)
  verificationStatus            OwnershipVerificationStatus @default(UNVERIFIED)
  verificationSubmittedAt       DateTime?
  verificationReviewedAt        DateTime?
  verificationNotes             String?
  verificationRequested         Boolean                     @default(false)
  verificationProofUrl          String?
  hypeCount                     Int                         @default(0)
  // Settings' "Show me in discovery" / "Show me in demand radar" toggle —
  // honored by /discover, search, and the venue booking demand radar.
  discoverable                  Boolean                     @default(true)
  // Venue onboarding's "Room details" step (DESIGN_SYNC row 225) — shown on
  // the venue's own page/dashboard, distinct from a Show's own
  // ticketCapacity (a venue's max room size vs. one event's cap for that night).
  capacity                      Int?
  roomType                      String?
  ownerId                       String
  owner                         User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  hostedShows                   Show[]                      @relation("VenueShows")
  headlinerShows                Show[]                      @relation("HeadlinerShows")
  promotedShows                 Show[]                      @relation("PromotedShows")
  lineupSlots                   ShowLineupSlot[]
  mediaUploads                  ArtistMediaAsset[]
  profileHypes                  ProfileHypeEvent[]
  venueConnectionRequests       VenueConnectionRequest[]    @relation("VenueConnectionRequests")
  recommendedConnectionRequests VenueConnectionRequest[]    @relation("RecommendedProfileConnectionRequests")
  issuedTickets                 Ticket[]                    @relation("VenueIssuedTickets")
  affiliateTicketOrders         TicketOrder[]               @relation("AffiliatePromoterTicketOrders")
  accountsPayableEntries        AccountsPayableEntry[]
  journalPosts                  ArtistJournalPost[]
  followers                     Follow[]                    @relation("FollowedProfile")
  setlistTemplates              SetlistTemplate[]
  nowPlaying                    String?
  availabilityDates             AvailabilityDate[]
  albums                        Album[]
  receivedBookingRequests       BookingRequest[]            @relation("BookingRequestToProfile")
  promoCodes                    PromoCode[]
  fanMailLastSentAt             DateTime?
  newsletterSubscriptions       NewsletterSubscription[]

  @@index([name])
  @@index([city, type])
  // Prunes venue rows for /api/shows/nearby's bounding-box prefilter.
  @@index([latitude, longitude])
  @@index([ownerId])
  // Trigram indexes for /api/search ILIKE %q% lookups — without these every
  // search keystroke seq-scans the table (BitmapOr needs all OR arms indexed).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_name_trgm_idx")
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_headline_trgm_idx")
  @@index([bio(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_bio_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_city_trgm_idx")
  @@index([stateRegion(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_stateRegion_trgm_idx")
  @@index([hometown(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_hometown_trgm_idx")
  @@index([genres], type: Gin, map: "Profile_genres_gin_idx")
}

/// A one-time code that hands a ticket order to another ACCOUNT.
///
/// Distinct from the email transfer that already existed, and it has to be: the
/// email path rewrites holderEmail and leaves buyerUserId alone, while every
/// ticket list in the app is scoped `where: { buyerUserId }` — so an emailed
/// transfer left the order in the sender's list and never put it in the
/// recipient's. Claiming a code moves buyerUserId, which is what makes the
/// handoff real rather than a notification.
model TicketTransferCode {
  id            String      @id @default(cuid())
  /// Crockford base32, stored in canonical (normalized) form — see
  /// src/lib/ticket-transfer-code.ts. Unique so a claim is a single lookup and
  /// two live codes can never collide.
  code          String      @unique
  ticketOrderId String
  createdById   String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  /// Set the moment the code is spent. Single-use is enforced by a conditional
  /// update on this being null, not by a read-then-write.
  claimedAt     DateTime?
  claimedById   String?
  ticketOrder   TicketOrder @relation(fields: [ticketOrderId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("TicketTransferCodesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  claimedBy     User?       @relation("TicketTransferCodesClaimed", fields: [claimedById], references: [id], onDelete: SetNull)

  /// The order's live code is looked up to rotate it when a new one is minted.
  @@index([ticketOrderId, claimedAt])
}

model FanPlaylist {
  id        String            @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     FanPlaylistItem[]

  @@index([userId, createdAt])
}

model FanPlaylistItem {
  id                String      @id @default(cuid())
  playlistId        String
  mediaId           String
  title             String
  artistName        String
  url               String
  artistProfileSlug String?
  notes             String?
  artworkUrl        String?
  position          Int
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
