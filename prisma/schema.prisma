model SupportRequest {
  id              String   @id @default(cuid())
  requesterUserId String?
  type            String
  name            String?
  email           String?
  subject         String
  details         String
  status          String   @default("OPEN")
  priority        String   @default("NORMAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([requesterUserId, createdAt])
}

model Show {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  title                  String
  description            String?
  recapText              String?
  productionPlan         Json?
  productionPlanVersion  Int                    @default(1)
  isRadioShow            Boolean                @default(false)
  status                 ShowStatus             @default(DRAFT)
  startsAt               DateTime
  endsAt                 DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  creatorId              String
  creator                User                   @relation("CreatedShows", fields: [creatorId], references: [id], onDelete: Cascade)
  venueProfileId         String?
  venueProfile           Profile?               @relation("VenueShows", fields: [venueProfileId], references: [id])
  headlinerProfileId     String?
  headlinerProfile       Profile?               @relation("HeadlinerShows", fields: [headlinerProfileId], references: [id])
  promoterProfileId      String?
  promoterProfile        Profile?               @relation("PromotedShows", fields: [promoterProfileId], references: [id])
  posterImage            String?
  ticketingOpensAt       DateTime?
  bookingLegalNotes      String?
  isTicketed             Boolean                @default(false)
  ticketPriceCents       Int                    @default(0)
  ticketCapacity         Int?
  venuePayoutPercent     Int?
  artistPayoutPercent    Int?
  promoterPayoutPercent  Int                    @default(10)
  ticketsSoldCount       Int                    @default(0)
  hypeCount              Int                    @default(0)
  tags                   String[]
  hypes                  HypeEvent[]
  showListens            ShowListen[]
  ticketOrders           TicketOrder[]
  tickets                Ticket[]
  accountsPayableEntries AccountsPayableEntry[]
  radioTracks            RadioShowTrack[]
  advertisingConfig      ShowAdvertisingConfig?
  lineupSlots            ShowLineupSlot[]
  comments               ShowComment[]
  rsvps                  ShowRsvp[]
  attendees              ShowAttendee[]
  setlistProgress        Json?
  setlistVotes           SetlistVote[]
  promoCodes             PromoCode[]
  moderationStatus       String                 @default("APPROVED")
  featured               Boolean                @default(false)
  capacityAlertSentAt    DateTime?
  dmcaDeadline           DateTime?
  dmcaStatus             String?
  // Organizer-initiated cancellation (Event Cancellation Flow) — distinct
  // from the admin-moderation CANCELED path, which has no reason recorded.
  cancellationReason     String?
  // Optional free text the organizer writes for their own ticket holders on
  // cancellation. Kept separate from cancellationReason, which only ever
  // holds one of four fixed labels — folding them together would make it
  // impossible to tell an organizer's words from the platform's.
  cancellationMessage    String?
  canceledAt             DateTime?

  @@index([startsAt, status])
  @@index([status])
  @@index([isRadioShow, status])
  @@index([creatorId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Show_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Show_description_trgm_idx")
}

// Lineup & Split Agreement (DESIGN_SYNC row 226) — only relevant when a Show
// has more than one billed act. A show with zero rows here pays its entire
// artistPayoutPercent to Show.headlinerProfileId exactly as before (no
// behavior change for the common single-act case). When rows exist, each
// act's splitPercent is that act's share of the ticket price (siblings sum
// to Show.artistPayoutPercent, matching how venue/artist/promoter already
// sum to 100%) — the venue proposes the lineup + splits, every named act
// must ACCEPT before the show can leave DRAFT and go on sale.
model ShowLineupSlot {
  id           String           @id @default(cuid())
  showId       String
  show         Show             @relation(fields: [showId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  isHeadliner  Boolean          @default(false)
  splitPercent Int
  status       LineupSlotStatus @default(PENDING)
  proposedAt   DateTime         @default(now())
  respondedAt  DateTime?

  @@unique([showId, profileId])
  @@index([profileId, status])
}

model ShowAdvertisingConfig {
  id        String   @id @default(cuid())
  showId    String   @unique
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  scope     String   @default("local")
  frequency Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketOrder {
  id                         String                 @id @default(cuid())
  confirmationCode           String                 @unique
  showId                     String
  buyerUserId                String?
  buyerName                  String
  buyerEmail                 String
  quantity                   Int
  status                     TicketOrderStatus      @default(RESERVED)
  paymentTokenRef            String?
  stripePaymentIntentId      String?                @unique
  affiliatePromoterProfileId String?
  subtotalCents              Int
  taxLocalCents              Int                    @default(0)
  taxStateCents              Int                    @default(0)
  taxCountryCents            Int                    @default(0)
  taxInternationalCents      Int                    @default(0)
  totalTaxCents              Int                    @default(0)
  // Stripe's fee, paid by the buyer on top of face value and taxes. iHYPE is a
  // nonprofit and absorbs no fee, so this is recorded per order rather than
  // recomputed: the rate can change, and a receipt has to say what was actually
  // charged on the day, not what today's rate would make of it.
  processingFeeCents         Int                    @default(0)
  totalChargeCents           Int                    @default(0)
  venuePayoutCents           Int
  artistPayoutCents          Int
  promoterPayoutCents        Int
  locationCity               String?
  locationStateRegion        String?
  locationCountry            String?
  locationPostalCode         String?
  chargedAt                  DateTime?
  /// The Connect account this order was settled ON BEHALF OF, when the charge
  /// was a destination charge. Null means the platform settled it and the whole
  /// split is paid out afterwards through AccountsPayableEntry.
  ///
  /// It has to be stored rather than re-derived: `buildPayableEntries` runs at
  /// capture and must NOT write an artist payable for a share Stripe already
  /// routed, or the payout cron would pay that act a second time. Asking Stripe
  /// at capture time would put a network call inside the money transaction.
  /// Which party was the merchant on this charge, and therefore which share
  /// never passed through iHYPE's balance. Load-bearing at capture: writing a
  /// payable for a share Stripe already delivered would pay that party twice.
  ///
  ///   PLATFORM      iHYPE settled it; every share is paid from payables.
  ///   DESTINATION   destination charge; the ARTIST's share went with it.
  ///   VENUE_DIRECT  charge on the venue's own account; the VENUE's share and
  ///                 the TAX stayed with them, and iHYPE holds only the
  ///                 artist's and promoter's shares as an application fee.
  ///
  /// A string rather than an enum so adding a mode needs no migration on a
  /// table that carries live orders.
  settlementMode             String                 @default("PLATFORM")
  settlementAccountId        String?
  /// The protection reserve collected on this order, in cents. Held by the
  /// platform against refunds, disputes and Connect's own fees — see
  /// TICKET_RESERVE_PERCENT. Recorded per order so the fund can be reconciled
  /// against what it actually pays out, which is the only way to know whether
  /// 1.5% is the right number.
  reserveFeeCents            Int                    @default(0)
  refundedAt                 DateTime?
  stripeRefundId             String?
  transferredAt              DateTime?
  transferredToEmail         String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  show                       Show                   @relation(fields: [showId], references: [id], onDelete: Cascade)
  buyerUser                  User?                  @relation("BuyerTicketOrders", fields: [buyerUserId], references: [id], onDelete: SetNull)
  affiliatePromoterProfile   Profile?               @relation("AffiliatePromoterTicketOrders", fields: [affiliatePromoterProfileId], references: [id], onDelete: SetNull)
  tickets                    Ticket[]
  transferCodes              TicketTransferCode[]
  accountsPayableEntries     AccountsPayableEntry[]
  promoCodeId                String?
  promoCode                  PromoCode?             @relation(fields: [promoCodeId], references: [id])

  @@index([buyerUserId])
}

