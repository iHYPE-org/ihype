<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>iHYPE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>iHYPE uses your approximate location while the app is open to show nearby local music, venues, and events.</string>
	<!-- Declared ahead of the scanner it is for. Ticket check-in is a text
	     field today and nothing calls getUserMedia, but a WKWebView camera
	     request with no usage string does not fail — iOS kills the app. The
	     string has to be in the binary BEFORE the first camera call ships,
	     and it costs nothing until then: iOS only ever surfaces it at the
	     moment of the prompt. Wording is the camera primer's own promise in
	     src/lib/permission-primers.ts; if that copy changes, change this. -->
	<key>NSCameraUsageDescription</key>
	<string>iHYPE uses the camera to scan ticket codes at the door. The frame is read and dropped — nothing is recorded and no image is stored.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Lets a silent/background push wake the app to refresh state. Inert
	     without the Push Notifications capability + a provisioning profile
	     (needs a real Apple Developer Program Team ID — see
	     DESIGN_SYNC.md's native-shell row) but harmless to declare now. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Export compliance, answered in the binary.

	     Without this key EVERY upload parks in App Store Connect at "Missing
	     Compliance" until a human answers the encryption question by hand, per
	     build — a step that is invisible until the first TestFlight upload sits
	     there not distributing.

	     false is correct here: iHYPE uses only HTTPS/TLS, which is exempt under
	     the standard exemption. It ships no custom or proprietary cryptography.
	     If that ever changes, this key changes with it and the answer becomes a
	     real filing, not a checkbox. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
